# Shopify Storefront / Admin Configuration
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

# WordPress Site Configuration
WORDPRESS_URL=https://your-site.com
WORDPRESS_USER=your_username
WORDPRESS_APP_PASSWORD=your_app_password
WP_SITE_URL=https://your-site.com
WP_USERNAME=your_username
WP_APPLICATION_PASSWORD=your_app_password
WP_TOKEN=your_jwt_or_bearer_token

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Production WordPress Configuration
PROD_WP_URL=https://your-site.com
PROD_WP_USER=your_username
PROD_WP_PASS=your_password
